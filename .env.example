# Nexus Matching Engine - Environment Variables Example
# Copy this file to .env and fill in your actual values
# Never commit your actual .env file to version control

# JWT Secret - Generate a strong random secret (32+ characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-strong-jwt-secret-here

# TwelveData API Key - Get from https://twelvedata.com/
TWELVEDATA_API_KEY=your-twelvedata-api-key-here

# CORS Configuration - Set to your frontend domain in production
# For local development: ALLOWED_ORIGIN="*" (wildcard) or leave empty for default wildcard
# For production: ALLOWED_ORIGIN="https://your-frontend-domain.com"
ALLOWED_ORIGIN="*"

# Database Configuration (if needed)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=your-db-password
# DB_NAME=nexus
